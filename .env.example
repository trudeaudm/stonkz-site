# Factories redeploy at genesis; ladder contracts will redeploy
# before public launch. A redeploy is a config change here, never a code change.
# Local dev: copy to .env.local (gitignored).
#
# Express V4 factory (2026-08). V1 0xdaA8…727b4 / V2 0x3eAb…C5Fd /
# V3 0xb510…A338 are orphaned generations; BONZI/T/SDONK live on old
# adapters and will not appear once env flips (indexer is per-factory).
# Cache key rotates automatically on address change.
VITE_CHAIN_ID=4663
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com
VITE_BETA_GATE=1
VITE_TESTER_ALLOWLIST=
# ETH settle buffer for list(), in WEI. Measured consumption at
# fork block 35828651: 103160 wei ($4k) / 145658 wei ($8k); default 1e6 =
# ~7-10x margin. Excess above consumption refunds to the listing and is
# currently unrecoverable — keep this small. Re-measure after any factory
# redeploy.
VITE_LIST_BUFFER_WEI=1000000
# Express V4 deploy block — scanning floor
VITE_INDEX_FROM_BLOCK=38007365
VITE_ADDR_V4_ADAPTER=0x97F2b8679E70962A56A56338f54A2073a37aAF6C
# Optional PoolManager override (Swap logs). Prefer on-chain adapter.manager() —
# not required on Render when Express factory + adapter are wired.
VITE_ADDR_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
# Universal Router (V4_SWAP) + Permit2 — required for in-app trading.
# Set both on Render before rebuild; panel disables if either is unset.
VITE_ADDR_UNIVERSAL_ROUTER=0x06AfBA43Fd06227fA663b0DAecF536f6EaA6bf99
VITE_ADDR_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
VITE_ADDR_FEE_HOOK=0x4663c4c5Cb6F826d148cD38aDaF9157f483d0088
VITE_ADDR_CTO_GOVERNOR=0x3990070971595C49e1646eD5347252AB028449d0
VITE_ADDR_FEE_LOCKER_V2=0xf7e02D3F51Fe22Fa0428821552a087cFf07f0300
VITE_ADDR_BUYBACK_ACCUM=0x100afE1947De681C71808Ce4b1554bEF50Adc8F1
VITE_ADDR_LADDER_SETTLEMENT=0x6b6E777d743A97010bf2C79E9F22A9A215c1a7E1
VITE_ADDR_VAULT=0x6ff723f62C61292CDF776Edc76e0Da5ea6D5549c
VITE_ADDR_EXPRESS_FACTORY=0xEe2590c39E1485ed2F9cdaA684ab7B91d284E94a
VITE_ADDR_LADDER_FACTORY=0xdfF96ADb478EB7C54ECf7a169C6B3205c7002676
VITE_ADDR_SAFE=0x9D116B03FA6eB7F02c232670Bc083530609c5572
